rules_version = '2';

// Regras do Firestore do histórico de sacolas (projeto sacolas-b5dc9).
// Colar em: Firebase Console → Firestore Database → Regras → Publicar.
//
// Login é por usuário e senha: o app transforma "fulano" em
// "fulano@sacolas-b5dc9.firebaseapp.com" (conta criada em Authentication → Users).
// Quem pode acessar: usuários que existam como ID de documento na coleção "permitidos"
// (ex.: permitidos/fulano). Essa coleção só é editada pelo console — o app não consegue
// ler nem gravar nela. Crie a conta do usuário ANTES do documento em "permitidos".
service cloud.firestore {
  match /databases/{database}/documents {
    function permitido() {
      return request.auth != null
        && request.auth.token.email.matches('[a-z0-9._-]+@sacolas-b5dc9[.]firebaseapp[.]com')
        && exists(/databases/$(database)/documents/permitidos/$(request.auth.token.email.split('@')[0]));
    }

    match /sacolas_mensal/{id} {
      allow read, write: if permitido();
    }
  }
}
